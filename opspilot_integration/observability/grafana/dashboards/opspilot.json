{
  "id": null,
  "uid": "opspilot-integration",
  "title": "OpsPilot \u2014 Live Incidents",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests per second",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "opspilot-prom"
      },
      "targets": [
        {
          "expr": "sum(rate(opspilot_http_requests_total[1m]))",
          "legendFormat": "HTTP requests per second",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx percentage",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "opspilot-prom"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(opspilot_http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(opspilot_http_requests_total[1m])),0.001)",
          "legendFormat": "HTTP 5xx percentage",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency (seconds)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "opspilot-prom"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(opspilot_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "HTTP p95 latency (seconds)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Demo metrics availability",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "opspilot-prom"
      },
      "targets": [
        {
          "expr": "up{job=\"opspilot-demo\"}",
          "legendFormat": "Demo metrics availability",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    }
  ]
}