import os
from typing import TypedDict, NotRequired

from groq import Groq
from langgraph.graph import StateGraph, START, END

from ai_service.app.k8s_tools import k_get_pods


# Shared state
class AgentState(TypedDict):
    incident: str
    pod_info: NotRequired[str]
    analysis: NotRequired[str]


# Node 1: Collect Kubernetes evidence
def collect_evidence(state: AgentState):
    print("STEP 1: Collecting Kubernetes evidence...")

    pods = k_get_pods()

    return {
        "pod_info": str(pods)
    }


# Node 2: Analyze evidence with Groq
def investigate(state: AgentState):
    print("STEP 2: Investigating with Groq AI...")

    client = Groq(api_key=os.environ["GROQ_API_KEY"])

    response = client.chat.completions.create(
        model="openai/gpt-oss-20b",
        messages=[
            {
                "role": "system",
                "content": (
                    "You are an AI SRE engineer. "
                    "Analyze only the supplied Kubernetes evidence. "
                    "Never invent logs, failures, or root causes. "
                    "If evidence is insufficient, say so. "
                    "Do not execute remediation."
                ),
            },
            {
                "role": "user",
                "content": (
                    f"Incident: {state['incident']}\n\n"
                    f"Kubernetes evidence:\n{state['pod_info']}"
                ),
            },
        ],
    )

    return {
        "analysis": response.choices[0].message.content or ""
    }


# Build LangGraph
workflow = StateGraph(AgentState)

workflow.add_node("collect_evidence", collect_evidence)
workflow.add_node("investigate", investigate)

workflow.add_edge(START, "collect_evidence")
workflow.add_edge("collect_evidence", "investigate")
workflow.add_edge("investigate", END)

agent = workflow.compile()
